# Cache-regler til webserveren (Apache, fx Simply.com).
# Filen ligger i public/, så Vite kopierer den med over i dist/ og dermed i release-zip'en.
#
# index.html skal altid tjekkes hos serveren (no-cache). Den peger på de aktuelle filer
# i assets/, og efter et nyt deploy findes de gamle filer ikke længere. Uden denne regel
# kan browseren genbruge en gammel index.html og vise en tom side.
#
# Filerne i assets/ har et hash i navnet (fx index-BqaRT-9M.js), som skifter ved hver build.
# De må derfor caches i et år uden at blive tjekket igen.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </Files>

  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Expires
  </FilesMatch>
</IfModule>
